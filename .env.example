# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase.
# Estes dois valores são públicos (vão no site que roda no navegador) — sem problema.
# NUNCA coloque aqui a senha do banco nem a chave "secret".

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
